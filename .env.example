# Copie este arquivo para .env.local e preencha os valores
# O arquivo .env.local nunca deve ser commitado no Git

# Google Drive API
# Crie em: console.cloud.google.com > APIs e Serviços > Credenciais > Criar credenciais > Chave de API
VITE_GOOGLE_API_KEY=

# ID da pasta do Google Drive que contém as imagens (artes)
# Extraia do link da pasta: drive.google.com/drive/folders/ESTE_TRECHO_AQUI
VITE_GOOGLE_DRIVE_FOLDER_ID=

# ID do arquivo de mapa no Google Drive
# Extraia do link: drive.google.com/file/d/ESTE_TRECHO_AQUI/view
VITE_GOOGLE_DRIVE_MAP_FILE_ID=

# URL base do backend RPG (sem barra no final)
# Dev:  http://localhost:3002
# Prod: https://dn-d-keeper-backend.vercel.app
VITE_BACKEND_URL=http://localhost:3002
